        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom",
        "Directory"
      ]
    }
  ]
}